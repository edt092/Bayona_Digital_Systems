---
import Logo from '@/components/ui/Logo.astro';
import { services } from '@/data/services';
import { projects } from '@/data/projects';
import { site } from '@/data/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Servicios',
    links: [
      { label: 'Todos los servicios', href: '/servicios/' },
      ...services.map(s => ({ label: s.title, href: `/servicios/${s.slug}/` })),
    ],
  },
  {
    title: 'Casos de estudio',
    links: [
      { label: 'Todos los casos', href: '/proyectos/' },
      ...projects.map(p => ({ label: p.title, href: `/proyectos/${p.slug}/` })),
    ],
  },
  {
    title: 'Bayona Digital Systems',
    links: [
      { label: 'Cómo trabajamos', href: '/como-trabajamos/' },
      { label: 'Contacto', href: '/contacto/' },
      { label: 'Privacidad', href: '/privacidad/' },
      { label: 'Términos de uso', href: '/terminos/' },
    ],
  },
];
---

<footer class="border-t border-line bg-[#080E1A]">
  <div class="container-site grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="inline-block rounded-md" aria-label="Bayona Digital Systems — Inicio">
        <Logo />
      </a>
      <p class="mt-5 max-w-xs text-[0.9375rem] text-muted">
        Productos web, automatización e integración de datos para operaciones B2B.
      </p>
      <ul class="mt-6 space-y-2 text-[0.9375rem]">
        <li>
          <a href={`mailto:${site.email}`} class="text-link">{site.email}</a>
        </li>
        <li>
          <a href={site.github} class="text-link" target="_blank" rel="noopener noreferrer">
            GitHub<span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        </li>
      </ul>
    </div>

    {columns.map(col => (
      <nav aria-label={col.title}>
        <h2 class="font-mono text-[0.8125rem] font-medium tracking-[0.04em] text-muted">{col.title}</h2>
        <ul class="mt-4 space-y-1">
          {col.links.map(link => (
            <li>
              <a href={link.href} class="inline-flex min-h-10 items-center text-[0.9375rem] text-soft hover:text-ink hover:underline underline-offset-4">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-line">
    <div class="container-site py-5 text-sm text-muted">
      © {year} Bayona Digital Systems
    </div>
  </div>
</footer>
