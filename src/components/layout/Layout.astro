---
import SEO from './SEO.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import '@/styles/global.css';
import interFont from '@/assets/fonts/inter-latin-var.woff2?url';
import displayFont from '@/assets/fonts/space-grotesk-latin-var.woff2?url';

interface Props {
  title?: string;
  brand?: boolean;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  type?: 'website' | 'article';
  schema?: object[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B1220" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <SEO {...props} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Navbar />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
