---
import Logo from '@/components/ui/Logo.astro';
import { mainNav, primaryCta } from '@/data/site';

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header sticky top-0 z-50 border-b border-line bg-base/95 backdrop-blur">
  <nav class="container-site flex h-16 items-center justify-between gap-4" aria-label="Principal">
    <a href="/" class="rounded-md" aria-label="Bayona Digital Systems — Inicio">
      <Logo />
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {mainNav.map(link => (
        <li>
          <a
            href={link.href}
            class="nav-link"
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a href={primaryCta.href} class="btn btn-primary btn-sm hidden sm:inline-flex">
        {primaryCta.label}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-soft hover:bg-surface md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only" data-menu-label>Abrir menú</span>
        <svg data-icon="open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <svg data-icon="close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-base md:hidden">
    <ul class="container-site flex flex-col gap-1 py-4">
      {mainNav.map(link => (
        <li>
          <a
            href={link.href}
            class="flex min-h-11 items-center rounded-lg px-3 text-base font-medium text-soft hover:bg-surface hover:text-ink aria-[current=page]:text-ink"
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2 border-t border-line pt-4">
        <a href={primaryCta.href} class="btn btn-primary w-full">{primaryCta.label}</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-soft);
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
  }
  .nav-link:hover { color: var(--color-ink); background: var(--color-surface); }
  .nav-link[aria-current='page'] {
    color: var(--color-ink);
    box-shadow: inset 0 -2px 0 var(--color-action);
    border-radius: 0;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean, returnFocus = false) => {
    if (!toggle || !menu) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
    const label = toggle.querySelector('[data-menu-label]');
    if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
    else if (returnFocus) toggle.focus();
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false, true);
    }
  });

  window.matchMedia('(min-width: 768px)').addEventListener('change', event => {
    if (event.matches) setOpen(false);
  });
</script>
