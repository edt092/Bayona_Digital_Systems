---
import { site } from '@/data/site';

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = '¿Qué necesita resolver tu equipo?',
  text = 'Describe el reto en unas líneas. Con esa información se propone una conversación para revisarlo y definir el siguiente paso.',
  ctaLabel = 'Hablemos de tu proyecto',
  ctaHref = '/contacto/',
} = Astro.props;
---

<section class="section" aria-labelledby="cta-title">
  <div class="container-site">
    <div class="panel relative overflow-hidden px-6 py-12 md:px-12 md:py-14">
      <div class="bg-blueprint absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="relative grid gap-8 md:grid-cols-[1.4fr_1fr] md:items-end">
        <div>
          <h2 id="cta-title" class="text-[clamp(1.75rem,3.5vw,2.5rem)]">{title}</h2>
          <p class="measure mt-4 text-soft">{text}</p>
        </div>
        <div class="flex flex-col gap-3 md:items-end">
          <a href={ctaHref} class="btn btn-primary">{ctaLabel}</a>
          <p class="text-[0.9375rem] text-muted">
            O escribe directamente a <a href={`mailto:${site.email}`} class="text-link">{site.email}</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
