---
import type { FaqItem } from '@/types';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {items.map(item => (
    <details class="faq group">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 font-display text-lg font-semibold text-ink">
        {item.question}
        <svg class="shrink-0 text-muted transition-transform group-open:rotate-45" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </summary>
      <p class="measure pb-5 text-soft">{item.answer}</p>
    </details>
  ))}
</div>

<style>
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:focus-visible { outline-offset: 0; }
</style>
