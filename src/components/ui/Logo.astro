---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-3 ${className}`}>
  <svg width="30" height="30" viewBox="0 0 48 48" aria-hidden="true" class="shrink-0">
    <rect width="48" height="48" rx="10" fill="#152238" />
    <g transform="translate(8.5 10) scale(0.82)" fill="#F8FAFC">
      <rect x="0" y="0" width="5.5" height="34" />
      <rect x="0" y="0" width="20" height="5" />
      <rect x="0" y="14.5" width="13" height="5" />
      <rect x="0" y="29" width="20" height="5" />
      <path d="M26,0 L31,0 A8.5,8.5 0 0,1 31,17 L26,17 L31,17 A8.5,8.5 0 0,1 31,34 L26,34 Z" />
    </g>
    <rect x="39" y="39" width="5" height="5" rx="1.25" fill="#BEF264" />
  </svg>
  <span class="flex flex-col whitespace-nowrap leading-none">
    <span class="font-display font-semibold text-[15px] tracking-[0.02em] text-ink">Bayona Digital</span>
    <span class="font-mono text-[12px] tracking-[0.12em] text-muted mt-1">SYSTEMS</span>
  </span>
</span>
