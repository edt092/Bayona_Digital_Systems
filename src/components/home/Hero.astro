---
import { Image } from 'astro:assets';
import { getProject } from '@/data/projects';
import PipelineDiagram from '@/components/ui/PipelineDiagram.astro';

const ks = getProject('ks-promocionales')!;

const steps = [
  { label: 'Catálogo del proveedor', detail: 'Extracción con Python' },
  { label: 'Postgres serverless', detail: 'Datos desacoplados del despliegue' },
  { label: 'Enriquecimiento con IA', detail: 'Fichas generadas por lotes' },
  { label: 'Control de calidad', detail: 'Noindex en fichas no enriquecidas' },
  { label: 'Build estático', detail: '2.096 páginas de producto' },
  { label: 'CDN', detail: 'Publicación automática en cada commit' },
];
---

<section class="relative overflow-hidden border-b border-line" aria-labelledby="hero-title">
  <div class="bg-blueprint absolute inset-0 [mask-image:radial-gradient(ellipse_at_70%_30%,black,transparent_70%)]" aria-hidden="true"></div>

  <div class="container-site relative grid gap-12 pb-16 pt-12 md:pt-16 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-14 lg:pb-24 lg:pt-20">
    <div>
      <p class="eyebrow mb-5">Productos web · Automatización · Datos</p>
      <h1 id="hero-title" class="text-[clamp(2.125rem,4.2vw,3.375rem)] leading-[1.08]">
        Productos web y automatización para operaciones B2B.
      </h1>
      <p class="lead measure mt-6">
        Bayona Digital Systems diseña y desarrolla plataformas, catálogos e integraciones que conectan tus datos y
        reducen el trabajo manual de tu equipo.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contacto/" class="btn btn-primary">Hablemos de tu proyecto</a>
        <a href="/proyectos/" class="btn btn-secondary">Explorar casos</a>
      </div>
      <p class="mt-5 text-[0.9375rem] text-muted">
        Interlocución técnica directa con Edwin Bayona desde la primera conversación.
      </p>
    </div>

    <figure class="relative" aria-labelledby="hero-figure-caption">
      <div class="panel hidden overflow-hidden shadow-2xl shadow-black/40 md:block">
        <div class="flex items-center gap-2 border-b border-line px-4 py-2.5" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-control"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-control"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-control"></span>
          <span class="ml-3 truncate font-mono text-xs text-muted">KS Promocionales · catálogo B2B</span>
        </div>
        <Image
          src={ks.image}
          alt={ks.imageAlt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1280px) 560px, (min-width: 1024px) 45vw, 90vw"
          format="webp"
          loading="eager"
          class="aspect-[16/10] w-full object-cover object-top"
        />
      </div>

      <div class="md:-mt-24 md:ml-8 md:mr-[-0.5rem] lg:-ml-10 relative">
        <PipelineDiagram title="Cómo se construye el catálogo" steps={steps} />
      </div>

      <figcaption id="hero-figure-caption" class="mt-4 text-sm text-muted">
        Flujo real del proyecto KS Promocionales.
        <a href="/proyectos/ks-promocionales/" class="text-link">Ver el caso completo</a>
      </figcaption>
    </figure>
  </div>
</section>
