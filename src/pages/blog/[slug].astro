---
import { getCollection } from 'astro:content';
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import CtaBand from '@/components/ui/CtaBand.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} description={post.data.description} type="article">
  <PageHeader
    eyebrow={post.data.category}
    title={post.data.title}
    lead={post.data.description}
    breadcrumbs={[{ label: 'Blog', href: '/blog/' }, { label: post.data.title }]}
  >
    <p class="mt-5 text-[0.9375rem] text-muted">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
      </time>
      · {post.data.readTime} de lectura
    </p>
  </PageHeader>

  <article class="section">
    <div class="container-site">
      <div class="prose-site">
        <Content />
      </div>
      <a href="/blog/" class="btn btn-secondary mt-14">Volver al blog</a>
    </div>
  </article>

  <CtaBand />
</Layout>
