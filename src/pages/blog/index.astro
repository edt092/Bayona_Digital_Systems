---
import { getCollection } from 'astro:content';
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Blog: productos web y datos"
  description="Artículos de Bayona Digital Systems sobre desarrollo de productos web, automatización e integración de datos."
  noindex={posts.length === 0}
>
  <PageHeader eyebrow="Blog" title="Notas sobre productos web, automatización y datos" breadcrumbs={[{ label: 'Blog' }]} />

  <section class="section">
    <div class="container-site">
      {posts.length === 0 ? (
        <div class="panel max-w-2xl p-8">
          <h2 class="text-xl">Todavía no hay artículos publicados</h2>
          <p class="mt-3 text-soft">Mientras tanto, los casos de estudio explican en detalle cómo se resolvieron proyectos reales.</p>
          <a href="/proyectos/" class="btn btn-primary mt-6">Explorar casos</a>
        </div>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2">
          {posts.map(post => (
            <li class="panel p-6">
              <p class="font-mono text-[0.8125rem] text-muted">
                {post.data.category} ·{' '}
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </p>
              <h2 class="mt-2 text-xl">
                <a href={`/blog/${post.slug}/`} class="hover:underline underline-offset-4">{post.data.title}</a>
              </h2>
              <p class="mt-2 text-soft">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>
