---
import Layout from '@/components/layout/Layout.astro';
import Hero from '@/components/home/Hero.astro';
import CaseCard from '@/components/ui/CaseCard.astro';
import FaqList from '@/components/ui/FaqList.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { featuredProjects, getProject } from '@/data/projects';
import { services } from '@/data/services';
import { processSteps, generalFaq } from '@/data/process';
import { site } from '@/data/site';
---

<Layout title={`${site.name} — ${site.tagline}`} description={site.description}>
  <Hero />

  <!-- Casos destacados -->
  <section class="section" aria-labelledby="casos-title">
    <div class="container-site">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow mb-4">Casos de estudio</p>
          <h2 id="casos-title" class="text-[clamp(1.75rem,3.5vw,2.5rem)]">Trabajo que puedes revisar</h2>
          <p class="measure mt-4 text-soft">
            Cada caso explica el problema, las decisiones técnicas y el resultado documentado. Los repositorios públicos
            están enlazados cuando existen.
          </p>
        </div>
        <a href="/proyectos/" class="btn btn-secondary self-start md:self-end">Ver todos los casos</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map(project => <CaseCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- Capacidades -->
  <section class="section border-y border-line bg-surface/40" aria-labelledby="capacidades-title">
    <div class="container-site">
      <p class="eyebrow mb-4">Servicios</p>
      <h2 id="capacidades-title" class="max-w-3xl text-[clamp(1.75rem,3.5vw,2.5rem)]">
        Capacidades para construir y mejorar tu producto digital
      </h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {services.map(service => {
          const related = getProject(service.relatedProjects[0]);
          return (
            <article class="panel flex flex-col p-6 md:p-8">
              <h3 class="text-2xl">{service.title}</h3>
              <p class="mt-3 text-soft">{service.summary}</p>
              <h4 class="mt-6 font-mono text-[0.8125rem] font-medium tracking-[0.04em] text-muted">Entregables</h4>
              <ul class="tick-list mt-3 text-[0.9375rem]">
                {service.deliverables.map(d => <li><strong class="font-semibold text-ink">{d.title}:</strong> {d.description}</li>)}
              </ul>
              <div class="mt-auto pt-8">
                <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-6">
                  <a href={`/servicios/${service.slug}/`} class="btn btn-secondary btn-sm">
                    Ver alcance y entregables
                    <span class="sr-only"> de {service.title}</span>
                  </a>
                  {related && (
                    <a href={`/proyectos/${related.slug}/`} class="text-link text-[0.9375rem]">
                      Caso relacionado: {related.title}
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="section" aria-labelledby="proceso-title">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="eyebrow mb-4">Cómo trabajamos</p>
          <h2 id="proceso-title" class="text-[clamp(1.75rem,3.5vw,2.5rem)]">Un método para reducir el riesgo de entrega</h2>
          <p class="mt-4 text-soft">
            Cada fase termina con algo que puedes revisar. Así las decisiones importantes se toman antes de invertir en
            desarrollo.
          </p>
          <a href="/como-trabajamos/" class="btn btn-secondary mt-8">Ver el proceso completo</a>
        </div>
        <ol class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line">
          {processSteps.map(step => (
            <li class="grid gap-2 bg-base p-5 sm:grid-cols-[4rem_1fr] sm:gap-4 md:p-6">
              <span class="font-mono text-sm text-action">{step.number}</span>
              <div>
                <h3 class="text-lg">{step.title}</h3>
                <p class="mt-1 text-[0.9375rem] text-soft">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Colaboración -->
  <section class="section border-y border-line bg-surface/40" aria-labelledby="colaboracion-title">
    <div class="container-site grid gap-10 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="eyebrow mb-4">Colaboración</p>
        <h2 id="colaboracion-title" class="text-[clamp(1.75rem,3.5vw,2.5rem)]">Un interlocutor técnico de principio a fin</h2>
        <p class="measure mt-4 text-soft">
          Tu interlocutor técnico es Edwin Bayona. Antes de comenzar se acuerdan responsables, entregables y la frecuencia
          de seguimiento, para que sepas en todo momento en qué punto está el proyecto.
        </p>
      </div>
      <dl class="grid gap-6 sm:grid-cols-2">
        <div class="border-l-2 border-action pl-4">
          <dt class="font-display text-lg font-semibold text-ink">Alcance por escrito</dt>
          <dd class="mt-1 text-[0.9375rem] text-soft">Lo incluido, lo excluido y los supuestos quedan documentados antes de empezar.</dd>
        </div>
        <div class="border-l-2 border-action pl-4">
          <dt class="font-display text-lg font-semibold text-ink">Revisiones sobre una versión de prueba</dt>
          <dd class="mt-1 text-[0.9375rem] text-soft">Ves el avance funcionando, no solo informes de estado.</dd>
        </div>
        <div class="border-l-2 border-action pl-4">
          <dt class="font-display text-lg font-semibold text-ink">Código y accesos a tu nombre</dt>
          <dd class="mt-1 text-[0.9375rem] text-soft">Repositorios, dominio y servicios quedan en cuentas de tu empresa, según se acuerde.</dd>
        </div>
        <div class="border-l-2 border-action pl-4">
          <dt class="font-display text-lg font-semibold text-ink">Decisiones documentadas</dt>
          <dd class="mt-1 text-[0.9375rem] text-soft">Las decisiones técnicas y su motivo quedan registradas para quien mantenga el sistema.</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container-site grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow mb-4">Preguntas frecuentes</p>
        <h2 id="faq-title" class="text-[clamp(1.75rem,3.5vw,2.5rem)]">Antes de escribirnos</h2>
      </div>
      <FaqList items={generalFaq} />
    </div>
  </section>

  <CtaBand />
</Layout>
