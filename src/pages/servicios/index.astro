---
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { services } from '@/data/services';
import { getProject } from '@/data/projects';
---

<Layout
  title="Servicios: productos web B2B y automatización de datos"
  description="Desarrollo de plataformas y catálogos web B2B, y automatización e integración de datos con pipelines, APIs y paneles. Alcance, entregables y casos relacionados."
>
  <PageHeader
    eyebrow="Servicios"
    title="Capacidades para construir y mejorar tu producto digital"
    lead="Dos líneas de trabajo complementarias. El diseño UX/UI y el SEO técnico forman parte de ambas: se definen flujos y estructura antes de desarrollar."
    breadcrumbs={[{ label: 'Servicios' }]}
  />

  <section class="section" aria-label="Listado de servicios">
    <div class="container-site grid gap-6">
      {services.map((service, i) => (
        <article class="panel grid gap-8 p-6 md:p-10 lg:grid-cols-[1.1fr_1fr]">
          <div>
            <p class="font-mono text-sm text-action">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="mt-3 text-[clamp(1.5rem,3vw,2rem)]">{service.title}</h2>
            <p class="mt-4 text-soft">{service.summary}</p>
            <a href={`/servicios/${service.slug}/`} class="btn btn-primary mt-8">
              Ver alcance y entregables<span class="sr-only"> de {service.title}</span>
            </a>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
            <div>
              <h3 class="font-mono text-[0.8125rem] font-medium tracking-[0.04em] text-muted">Problemas que resuelve</h3>
              <ul class="tick-list mt-3 text-[0.9375rem]">
                {service.scenarios.map(s => <li>{s.title}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="font-mono text-[0.8125rem] font-medium tracking-[0.04em] text-muted">Casos relacionados</h3>
              <ul class="mt-3 space-y-2 text-[0.9375rem]">
                {service.relatedProjects.map(slug => {
                  const p = getProject(slug);
                  return p && <li><a href={`/proyectos/${p.slug}/`} class="text-link">{p.title}</a></li>;
                })}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBand title="¿No sabes en qué servicio encaja tu reto?" text="Describe el problema tal como lo vive tu equipo. Se revisa y te proponemos el enfoque adecuado, o te decimos con franqueza si no encaja." />
</Layout>
