---
import { Image } from 'astro:assets';
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { projects } from '@/data/projects';
import { getService } from '@/data/services';
import type { Service } from '@/types';
import { site } from '@/data/site';
import { caseStudyNode } from '@/lib/seo';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const relatedServices = project.services.map(getService).filter((s): s is Service => Boolean(s));
// OG 1200×630 generada en build por src/pages/og/[slug].jpg.ts
const ogImage = `/og/${project.slug}.jpg`;
const pageUrl = new URL(`/proyectos/${project.slug}/`, Astro.site).toString();
const schema = [
  caseStudyNode(site.url, {
    name: project.title,
    headline: project.headline,
    description: project.summary,
    url: pageUrl,
    image: new URL(ogImage, Astro.site).toString(),
    about: relatedServices.map(s => s.title),
    repository: project.githubUrl,
  }),
];
const contactHref = `/contacto/?servicio=${project.services[0]}`;
---

<Layout
  title={project.seoTitle}
  description={project.summary}
  image={ogImage}
  imageAlt={project.imageAlt}
  imageWidth={1200}
  imageHeight={630}
  schema={schema}
  type="article"
>
  <PageHeader
    eyebrow={project.sector}
    title={project.headline}
    lead={project.summary}
    breadcrumbs={[{ label: 'Casos de estudio', href: '/proyectos/' }, { label: project.title }]}
  />

  <article>
    <!-- Resumen ejecutivo -->
    <section class="section pb-0" aria-labelledby="resumen-title">
      <div class="container-site">
        <h2 id="resumen-title" class="sr-only">Resumen ejecutivo</h2>
        <dl class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line md:grid-cols-3">
          <div class="bg-base p-6">
            <dt class="font-mono text-[0.8125rem] text-muted">Proyecto</dt>
            <dd class="mt-2 font-display text-lg font-semibold text-ink">{project.title}</dd>
          </div>
          <div class="bg-base p-6">
            <dt class="font-mono text-[0.8125rem] text-muted">Servicios</dt>
            <dd class="mt-2 space-y-1">
              {relatedServices.map(s => <a href={`/servicios/${s.slug}/`} class="text-link block">{s.title}</a>)}
            </dd>
          </div>
          <div class="bg-base p-6">
            <dt class="font-mono text-[0.8125rem] text-muted">{project.liveUrl ? 'Sitio y código' : 'Código'}</dt>
            <dd class="mt-2 space-y-1">
              {project.liveUrl && (
                <a href={project.liveUrl} class="text-link block" target="_blank" rel="noopener noreferrer">
                  Ver sitio publicado<span class="sr-only"> (se abre en una pestaña nueva)</span>
                </a>
              )}
              {project.githubUrl ? (
                <a href={project.githubUrl} class="text-link block" target="_blank" rel="noopener noreferrer">
                  Ver repositorio público<span class="sr-only"> (se abre en una pestaña nueva)</span>
                </a>
              ) : (
                <span class="text-soft">Repositorio privado</span>
              )}
            </dd>
          </div>
          <div class="bg-base p-6 md:col-span-3">
            <dt class="font-mono text-[0.8125rem] text-muted">Resultado técnico documentado</dt>
            <dd class="mt-2 font-display text-xl font-semibold text-ink md:text-2xl">{project.output}</dd>
            <dd class="mt-2 text-[0.9375rem] text-muted">{project.limitations}</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Captura -->
    <section class="section pb-0" aria-label="Captura del proyecto">
      <div class="container-site">
        <figure class="panel overflow-hidden">
          <Image
            src={project.image}
            alt={project.imageAlt}
            widths={[640, 960, 1349]}
            sizes="(min-width: 1216px) 1136px, 100vw"
            format="webp"
            loading="lazy"
            class="w-full"
          />
          <figcaption class="border-t border-line px-5 py-3 text-sm text-muted">Captura de {project.title}.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Problema y solución -->
    <section class="section" aria-labelledby="problema-title">
      <div class="container-site grid gap-10 lg:grid-cols-2">
        <div>
          <h2 id="problema-title" class="text-[clamp(1.5rem,3vw,2rem)]">El problema</h2>
          <p class="measure mt-4 text-soft">{project.problem}</p>
        </div>
        <div>
          <h2 class="text-[clamp(1.5rem,3vw,2rem)]">La solución</h2>
          <p class="measure mt-4 text-soft">{project.solution}</p>
          <h3 class="mt-8 font-mono text-[0.8125rem] font-medium tracking-[0.04em] text-muted">Alcance técnico</h3>
          <ul class="tick-list mt-3 text-[0.9375rem]">{project.scope.map(s => <li>{s}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- Decisiones -->
    <section class="section border-y border-line bg-surface/40" aria-labelledby="decisiones-title">
      <div class="container-site">
        <h2 id="decisiones-title" class="text-[clamp(1.5rem,3vw,2rem)]">Decisiones técnicas</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {project.decisions.map(d => (
            <article class="border-t-2 border-action pt-5">
              <h3 class="text-lg">{d.title}</h3>
              <p class="mt-2 text-[0.9375rem] text-soft">{d.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Resultados técnicos y detalle progresivo -->
    <section class="section" aria-labelledby="resultados-title">
      <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.2fr]">
        <div>
          <h2 id="resultados-title" class="text-[clamp(1.5rem,3vw,2rem)]">Qué se entregó</h2>
          <ul class="tick-list mt-6">{project.outputs.map(o => <li>{o}</li>)}</ul>
        </div>
        <div class="space-y-4">
          <details class="panel group p-0" open>
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 font-display text-lg font-semibold text-ink">
              Cómo funciona, paso a paso
              <svg class="shrink-0 text-muted transition-transform group-open:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <ol class="space-y-4 border-t border-line px-6 py-5">
              {project.pipeline.map((step, i) => (
                <li class="flex gap-4 text-[0.9375rem]">
                  <span class="font-mono text-sm text-action pt-0.5">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-soft">{step}</span>
                </li>
              ))}
            </ol>
          </details>
          <details class="panel group p-0">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 font-display text-lg font-semibold text-ink">
              Stack tecnológico
              <svg class="shrink-0 text-muted transition-transform group-open:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <dl class="grid gap-4 border-t border-line px-6 py-5 sm:grid-cols-2">
              {project.techStack.map(t => (
                <div>
                  <dt class="font-semibold text-ink">{t.name}</dt>
                  <dd class="text-[0.9375rem] text-muted">{t.role}</dd>
                </div>
              ))}
            </dl>
          </details>
        </div>
      </div>
    </section>
  </article>

  <!-- Siguiente paso -->
  <nav class="container-site" aria-label="Más casos">
    <a href={`/proyectos/${next.slug}/`} class="panel group flex flex-col gap-1 p-6 hover:border-control sm:flex-row sm:items-center sm:justify-between">
      <span>
        <span class="block font-mono text-[0.8125rem] text-muted">Siguiente caso</span>
        <span class="mt-1 block font-display text-lg font-semibold text-ink">{next.title}: {next.headline}</span>
      </span>
      <svg class="hidden shrink-0 text-action sm:block" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </nav>

  <CtaBand title="¿Tienes un reto parecido?" ctaHref={contactHref} />
</Layout>

<style>
  details summary::-webkit-details-marker { display: none; }
</style>
